document.addEventListener('DOMContentLoaded', () => {

    // 1. Alternador de Frases do Pennywise
    const quotes = [
        '"Nós todos flutuamos aqui em baixo. Você também vai flutuar!"',
        '"Eu sou Pennywise, o Palhaço Dançarino!"',
        '"Coma um amendoim, coma uma pipoca... É bem gostoso!"',
        '"Se você vier comigo, você flutuará também!"',
        '"A cidade de Derry é diferente de qualquer outro lugar onde já estive."'
    ];

    const quoteText = document.getElementById('quote-text');
    const quoteBtn = document.getElementById('quote-btn');

    quoteBtn.addEventListener('click', () => {
        const randomIndex = Math.floor(Math.random() * quotes.length);
        quoteText.textContent = quotes[randomIndex];
    });

    // 2. Criador de Balões Vermelhos Flutuantes
    const balloonBtn = document.getElementById('balloon-btn');
    const balloonContainer = document.getElementById('balloon-container');

    function createBalloon() {
        const balloon = document.createElement('div');
        balloon.classList.add('red-balloon');
        
        // Posição horizontal aleatória
        const randomX = Math.random() * (window.innerWidth - 60);
        balloon.style.left = `${randomX}px`;

        // Duração aleatória de animação entre 5s e 9s
        const randomDuration = 5 + Math.random() * 4;
        balloon.style.animationDuration = `${randomDuration}s`;

        balloonContainer.appendChild(balloon);

        // Remove o elemento após o término da animação para não acumular no DOM
        setTimeout(() => {
            balloon.remove();
        }, randomDuration * 1000);
    }

    balloonBtn.addEventListener('click', () => {
        // Gera 3 balões a cada clique
        for (let i = 0; i < 3; i++) {
            setTimeout(createBalloon, i * 300);
        }
    });

    // 3. Efeito ao rolar a página (Mudar o fundo do cabeçalho)
    const header = document.querySelector('header');
    window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
            header.style.backgroundColor = 'rgba(0, 0, 0, 0.95)';
            header.style.borderBottomColor = '#e50914';
        } else {
            header.style.backgroundColor = 'rgba(0, 0, 0, 0.9)';
            header.style.borderBottomColor = '#333';
        }
    });
});